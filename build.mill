//| mill-version: 1.3.0
package build

import mill._
import mill.scalalib._

// Deliberately excludes the Rocket/Chipyard-dependent Gemmini sources. The same
// tensorcore sources remain under src/main/scala for integration with build.sbt.
object tensorcore extends ScalaModule {
  def jvmVersion = "temurin:17"
  def scalaVersion = "2.13.10"
  def sources = Task.Sources(
    moduleDir / os.up / "src/main/scala/gemmini/tensorcore",
    moduleDir / os.up / "src/main/scala/gemmini/memory",
    moduleDir / os.up / "src/main/scala/gemmini/Activation.scala",
    moduleDir / os.up / "src/main/scala/gemmini/SyncMem.scala"
  )
  def mvnDeps = Seq(mvn"edu.berkeley.cs::chisel3:3.6.0")
  def scalacPluginMvnDeps = Seq(mvn"edu.berkeley.cs:::chisel3-plugin:3.6.0")
  def scalacOptions = Seq("-language:reflectiveCalls", "-deprecation", "-feature")
  object test extends ScalaTests with TestModule.ScalaTest {
    def forkArgs = Seq("-Xmx1536m", "-XX:ActiveProcessorCount=1")
    def forkEnv = Task {
      super.forkEnv() ++ Map("PATH" -> (
        (moduleDir / os.up / os.up / "scripts/tensorcore-verilator").toString +
          ":" + Task.env.getOrElse("PATH", "")))
    }
    def sources = Task.Sources(moduleDir / os.up / os.up / "src/test/scala/gemmini/tensorcore")
    def resources = Task.Sources(moduleDir / os.up / os.up / "modeling/tensorcore")
    def mvnDeps = Seq(
      mvn"edu.berkeley.cs::chiseltest:0.6.0",
      mvn"org.scalatest::scalatest:3.2.15"
    )
  }
}

// Parse edited integration sources without pretending to typecheck Chipyard,
// Rocket or HardFloat. Full system elaboration remains a separate release gate.
object integrationSyntax extends ScalaModule {
  def jvmVersion = "temurin:17"
  def scalaVersion = "2.13.10"
  def scalacOptions = Seq("-Ystop-after:parser")
  def sources = Task.Sources(
    moduleDir / os.up / "src/main/scala/gemmini/AccumulatorMem.scala",
    moduleDir / os.up / "src/main/scala/gemmini/AccumulatorScale.scala",
    moduleDir / os.up / "src/main/scala/gemmini/ExecuteController.scala",
    moduleDir / os.up / "src/main/scala/gemmini/Scratchpad.scala",
    moduleDir / os.up / "src/main/scala/gemmini/Controller.scala",
    moduleDir / os.up / "src/main/scala/gemmini/ConfigsTensor.scala",
    moduleDir / os.up / "src/main/scala/gemmini/GemminiConfigs.scala"
  )
}

// Actual, locked upstream implementations. No Rocket, DMA, HardFloat or
// targetutils API stubs are substituted for the integration build.
trait IntegrationScalaModule extends ScalaModule {
  def jvmVersion = "temurin:17"
  def scalaVersion = "2.13.10"
  def scalacOptions = Seq("-language:reflectiveCalls", "-Ymacro-annotations")
  def forkArgs = Seq("-Xmx1536m", "-XX:ActiveProcessorCount=1")
  protected def dependencyRoot(name: String): os.Path = {
    val root = moduleDir / os.up
    val path = root / "out/integration-deps" / name
    require(os.exists(path / ".git"), "Run scripts/setup-tensorcore-integration.sh first")
    val pin = os.read.lines(root / "integration/dependencies.lock")
      .filter(l => l.trim.nonEmpty && !l.trim.startsWith("#"))
      .map(_.split("\\s+")).find(_.head == name).get(2)
    require(os.proc("git", "-C", path, "rev-parse", "HEAD").call().out.trim() == pin,
      s"Dependency $name is not at the locked commit")
    require(os.proc("git", "-C", path, "status", "--porcelain").call().out.trim().isEmpty,
      s"Dependency $name has local modifications; preserve them and use a clean cache")
    path
  }
}

trait IntegrationChiselModule extends IntegrationScalaModule {
  def mvnDeps = Seq(mvn"edu.berkeley.cs::chisel3:3.6.0")
  def scalacPluginMvnDeps = Seq(mvn"edu.berkeley.cs:::chisel3-plugin:3.6.0")
}

object integrationCde extends IntegrationScalaModule {
  def sources = Task.Sources(dependencyRoot("cde") / "cde/src")
}
object integrationMacros extends IntegrationScalaModule {
  def sources = Task.Sources(dependencyRoot("rocket-chip") / "macros/src/main/scala")
  def mvnDeps = Seq(mvn"org.scala-lang:scala-reflect:2.13.10")
}
object integrationTargetUtils extends IntegrationChiselModule {
  def sources = Task.Sources(dependencyRoot("firesim") / "sim/midas/targetutils/src/main/scala")
}
object integrationHardfloat extends IntegrationChiselModule {
  def moduleDeps = Seq(integrationTargetUtils)
  def sources = Task.Sources(dependencyRoot("hardfloat") / "hardfloat/src/main/scala")
  def resources = Task.Sources(dependencyRoot("hardfloat") / "hardfloat/src/main/resources")
}
object integrationRocket extends IntegrationChiselModule {
  def moduleDeps = Seq(integrationCde, integrationMacros, integrationHardfloat)
  def sources = Task.Sources(dependencyRoot("rocket-chip") / "src/main/scala")
  def resources = Task.Sources(dependencyRoot("rocket-chip") / "src/main/resources")
  def mvnDeps = super.mvnDeps() ++ Seq(
    mvn"com.lihaoyi::mainargs:0.5.0",
    mvn"org.scala-lang:scala-reflect:2.13.10",
    mvn"org.json4s::json4s-jackson:4.0.5",
    mvn"org.scala-graph::graph-core:1.13.5",
    mvn"org.apache.commons:commons-lang3:3.12.0",
    mvn"org.apache.commons:commons-text:1.9"
  )
}

object integration extends IntegrationChiselModule {
  def moduleDeps = Seq(integrationRocket, integrationTargetUtils)
  def sources = Task.Sources(moduleDir / os.up / "src/main/scala",
    moduleDir / os.up / "integration/src/main/scala")
  object test extends ScalaTests with TestModule.ScalaTest {
    def forkArgs = Seq("-Xmx1536m", "-XX:ActiveProcessorCount=1")
    def forkEnv = Task {
      super.forkEnv() ++ Map("PATH" -> (
        (moduleDir / os.up / os.up / "scripts/tensorcore-verilator").toString +
          ":" + Task.env.getOrElse("PATH", "")))
    }
    def sources = Task.Sources(
      moduleDir / os.up / os.up / "integration/src/test/scala",
      moduleDir / os.up / os.up / "src/test/scala/gemmini/tensorcore/TensorTestBackend.scala")
    def resources = Task.Sources(moduleDir / os.up / os.up / "modeling/tensorcore")
    def mvnDeps = Seq(mvn"edu.berkeley.cs::chiseltest:0.6.0", mvn"org.scalatest::scalatest:3.2.15")
  }
}

// DAC experiments are isolated from the released production source targets.
object dac extends IntegrationChiselModule {
  def moduleDeps = Seq(tensorcore, integrationHardfloat)
  def sources = Task.Sources(moduleDir / os.up / "experiments/dac/scala")
  object test extends ScalaTests with TestModule.ScalaTest {
    def forkArgs = Seq("-Xmx1536m", "-XX:ActiveProcessorCount=1")
    def forkEnv = Task {
      super.forkEnv() ++ Map("PATH" -> (
        (moduleDir / os.up / os.up / "scripts/tensorcore-verilator").toString +
          ":" + Task.env.getOrElse("PATH", "")))
    }
    def sources = Task.Sources(moduleDir / os.up / os.up / "experiments/dac/test",
      moduleDir / os.up / os.up / "src/test/scala/gemmini/tensorcore/TensorTestBackend.scala")
    def mvnDeps = Seq(mvn"edu.berkeley.cs::chiseltest:0.6.0", mvn"org.scalatest::scalatest:3.2.15")
  }
}
